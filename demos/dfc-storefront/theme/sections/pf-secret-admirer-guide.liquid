<section class="sap"><div class="wrap"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><div class="notice">Need a specific date or know the recipient personally? Use standard gifting. Consent must come before fulfillment.</div><p>Demo example: @example_recipient. No handle collection.</p></div></section>
{% schema %}
{
  "name": "Secret Admirer Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A surprise, with consent first."
    },
    {
      "type": "text",
      "id": "body",
      "label": "Explanation",
      "default": "This program depends on recipient consent. A specific date cannot be guaranteed."
    }
  ],
  "presets": [
    {
      "name": "Secret Admirer Guide"
    }
  ]
}
{% endschema %}