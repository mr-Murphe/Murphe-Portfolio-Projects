<section class="content"><div class="wrap"><h2>{{ section.settings.heading | escape }}</h2>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><p>{{ block.settings.answer | escape }}</p></details>{% endfor %}</div></section>
{% schema %}
{
  "name": "Trust Operations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clear expectations."
    }
  ],
  "presets": [
    {
      "name": "Trust Operations"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What should I know?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Approved answer",
          "default": "Confirm with the merchant before real fulfillment."
        }
      ]
    }
  ]
}
{% endschema %}