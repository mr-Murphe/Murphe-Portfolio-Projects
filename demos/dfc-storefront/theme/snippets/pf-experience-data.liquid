{% assign lead = product.metafields.phasefield.lead_time_days.value %}{"id":{{ product.id | append: '' | json }},"title":{{ product.title | json }},"reference_price":{{ product.price | divided_by: 100.0 | json }},"category":{{ product.type | json }},"styles":{{ product.metafields.phasefield.styles.value | default: empty_array | json }},"occasions":{{ product.metafields.phasefield.occasions.value | default: empty_array | json }},"lead_time_days":{{ lead | default: 999 | json }},"demo_available":{{ product.available | json }},"same_day_demo_eligible":{{ product.metafields.phasefield.same_day_eligible.value | default: false | json }},"secret_admirer_demo_eligible":{{ product.metafields.phasefield.sap_eligible.value | default: false | json }}}